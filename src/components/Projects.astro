---
import PreviewIcon from "../components/icons/PreviewIcon.astro";
import LinkButton from "./LinkButton.astro";
import Skeleton from "./Skeleton.astro";
import { getProfile } from "../lib/profile";

const { projects, skills } = await getProfile();

const SKILLICONS: Record<string, string> = {};
for (const group of skills) {
  for (const item of group.items) {
    if (item.skillicon) SKILLICONS[item.name] = item.skillicon;
  }
}

// Iconos que no existen en skillicons.dev.
const SKILLICON_OVERRIDES: Record<string, string> = {
  Strapi: "https://go-skill-icons.vercel.app/api/icons?i=strapi",
};

function skilliconUrl(name: string) {
  if (SKILLICON_OVERRIDES[name]) return SKILLICON_OVERRIDES[name];
  const value = SKILLICONS[name];
  if (value) {
    return value.startsWith("http")
      ? value
      : `https://skillicons.dev/icons?i=${value}`;
  }
  const slug = /^[a-z0-9]+$/i.test(name) ? name.toLowerCase() : null;
  return slug ? `https://skillicons.dev/icons?i=${slug}` : null;
}

const projectImages = import.meta.glob("../assets/projects/*", {
  eager: true,
  import: "default",
}) as Record<string, { src: string }>;

function resolveImage(file?: string) {
  if (!file) return undefined;
  const key = Object.keys(projectImages).find((path) =>
    path.endsWith(`/${file}`),
  );
  return key ? projectImages[key].src : undefined;
}

const PROJECTS = projects.map((project) => ({
  ...project,
  displayTitle: project.card_title ?? project.title,
  preview: project.demo ?? project.link,
  href: project.repo ?? project.demo ?? project.link ?? "#",
  imageSrc: resolveImage(project.image),
}));
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map((project) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          {project.imageSrc && (
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl">
              <Skeleton class="w-full h-56 rounded-xl overflow-hidden">
                <img
                  alt={`Imagen de ${project.displayTitle}`}
                  class="object-cover object-top w-full h-full transition duration-500 md:scale-110 md:group-hover:scale-105"
                  loading="lazy"
                  src={project.imageSrc}
                />
              </Skeleton>
            </div>
          )}
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <a href={project.href}>{project.displayTitle}</a>
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row flex-wrap items-center mb-2 gap-x-2 gap-y-2">
              {project.tags?.map((name) => {
                const icon = skilliconUrl(name);
                return (
                  <li>
                    {icon ? (
                      <img
                        src={icon}
                        alt={name}
                        title={name}
                        class="size-8"
                        loading="lazy"
                      />
                    ) : (
                      <span class="text-xs text-gray-700 dark:text-gray-300">
                        {name}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {project.summary ? (
                project.summary
              ) : (
                <Fragment set:html={project.bodyHtml} />
              )}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {project.preview && (
                <LinkButton href={project.preview}>
                  Preview
                  <PreviewIcon class="size-4" />
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
