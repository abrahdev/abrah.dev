---
import TimelineItem from "./TimelineItem.astro";
import { getProfile } from "../lib/profile";

const { timeline } = await getProfile();
---

<ol class="relative">
  {
    timeline.map((entry) => (
      <li class="">
        <TimelineItem
          title={entry.title}
          company={entry.org ?? ""}
          description={entry.bodyHtml}
          link={entry.link}
          date={entry.date}
        />
      </li>
    ))
  }
</ol>
